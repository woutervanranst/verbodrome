{
  "name": "conjugation-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based conjugation for French, Dutch, German, English, Spanish, Italian and Latin, with step-by-step explanations",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./languages/fr": {
      "types": "./dist/languages/fr/index.d.ts",
      "import": "./dist/languages/fr/index.js"
    },
    "./languages/nl": {
      "types": "./dist/languages/nl/index.d.ts",
      "import": "./dist/languages/nl/index.js"
    },
    "./languages/de": {
      "types": "./dist/languages/de/index.d.ts",
      "import": "./dist/languages/de/index.js"
    },
    "./languages/en": {
      "types": "./dist/languages/en/index.d.ts",
      "import": "./dist/languages/en/index.js"
    },
    "./languages/es": {
      "types": "./dist/languages/es/index.d.ts",
      "import": "./dist/languages/es/index.js"
    },
    "./languages/it": {
      "types": "./dist/languages/it/index.d.ts",
      "import": "./dist/languages/it/index.js"
    },
    "./languages/la": {
      "types": "./dist/languages/la/index.d.ts",
      "import": "./dist/languages/la/index.js"
    },
    "./locales/en": {
      "types": "./dist/i18n/locales/en/index.d.ts",
      "import": "./dist/i18n/locales/en/index.js"
    },
    "./locales/nl": {
      "types": "./dist/i18n/locales/nl/index.d.ts",
      "import": "./dist/i18n/locales/nl/index.js"
    },
    "./equivalence": {
      "types": "./dist/equivalence/index.d.ts",
      "import": "./dist/equivalence/index.js"
    }
  },
  "bin": {
    "conjugation-engine": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "corpus:import": "node --experimental-strip-types scripts/corpus/import.ts",
    "corpus:check": "vitest run tests/corpus.test.ts tests/corpus-parser.test.ts && node --experimental-strip-types scripts/corpus/report.ts",
    "characterize:accept": "node --experimental-strip-types --import ./scripts/characterize/register.ts scripts/characterize/accept.ts",
    "characterize:write": "node --experimental-strip-types --import ./scripts/characterize/register.ts scripts/characterize/write.ts",
    "equivalence:matrix": "vitest run tests/equivalence/matrix.test.ts -u"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cheerio": "^1.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
