{
  "name": "verbodrome",
  "version": "0.1.0",
  "private": true,
  "description": "Franse vervoegingen oefenen voor Vlaamse scholen, gebouwd op conjugation-engine",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w conjugation-engine",
    "dev": "vite",
    "prebuild": "npm run build -w conjugation-engine",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build -w conjugation-engine",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w conjugation-engine",
    "test": "vitest run"
  },
  "dependencies": {
    "conjugation-engine": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
